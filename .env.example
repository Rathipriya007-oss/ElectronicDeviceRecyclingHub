# ReLoop Environment Configuration
# Optional: Google Gemini API Key for Live Computer Vision Analysis
# If not provided, ReLoop automatically runs on its built-in realistic diagnostic engine.
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_SUPABASE_URL=your_project_url
VITE_SUPABASE_ANON_KEY=your_anon_key
# Demo account credentials (create this user in Supabase Authentication > Users)
VITE_DEMO_EMAIL=demo@yourapp.com
VITE_DEMO_PASSWORD=your_demo_password_here